<Window x:Class="moshushou.ParseModeConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解析设置"
        Height="360"
        Width="620"
        MinHeight="340"
        MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="当前文件"
                   FontWeight="SemiBold"
                   Foreground="#334155"/>

        <Border Grid.Row="1"
                Margin="0,6,0,10"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Background="White"
                Padding="8">
            <TextBlock x:Name="FilePathTextBlock"
                       TextWrapping="Wrap"
                       Foreground="#0F172A"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="解析模式："
                       VerticalAlignment="Center"
                       Foreground="#334155"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="ModeComboBox"
                      Grid.Column="1"
                      Height="30"
                      SelectionChanged="ModeComboBox_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="3"
                x:Name="IssueConfigPanel"
                Margin="0,0,0,8"
                Padding="8"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="运单号列："
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           Margin="0,0,6,0"/>
                <TextBox x:Name="TrackingColumnTextBox"
                         Grid.Column="1"
                         Height="28"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="商家名列："
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           Margin="0,0,6,0"/>
                <TextBox x:Name="StoreColumnTextBox"
                         Grid.Column="4"
                         Height="28"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                x:Name="MagicianConfigPanel"
                Margin="0,0,0,8"
                Padding="8"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <StackPanel>
                <TextBlock Text="尾部自定义话术："
                           Foreground="#334155"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TailMessageTextBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="76"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5"
                   x:Name="HintTextBlock"
                   Foreground="#64748B"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="CancelButton"
                    Content="取消"
                    Width="80"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="ApplyButton"
                    Content="应用并重载"
                    Width="96"
                    Height="30"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
