<Window x:Class="moshushou.SegmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内容预览"
        Height="560"
        Width="860"
        MinHeight="360"
        MinWidth="560"
        Background="#F5F7FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderGradient}"
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05"/>
            </Border.Effect>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="CopyAllButton"
                            Content="全部复制"
                            Style="{StaticResource ModernButton}"
                            Background="#3B82F6"
                            Width="88"
                            Margin="0,0,6,0"
                            Click="CopyAllButton_Click"/>
                    <Button x:Name="CopyNumbersButton"
                            Content="复制单号"
                            Style="{StaticResource ModernButton}"
                            Background="#10B981"
                            Width="88"
                            Margin="0,0,6,0"
                            Click="CopyNumbersButton_Click"/>
                    <Button x:Name="ShowAllButton"
                            Content="所有内容"
                            Style="{StaticResource ModernButton}"
                            Background="#6B7280"
                            Width="88"
                            Margin="0,0,6,0"
                            Click="ShowAllButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="SummaryTextBlock"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#475569"
                               Margin="0,0,12,0"
                               Text="0 行"/>
                    <Button x:Name="CloseButton"
                            Content="关闭"
                            Style="{StaticResource ModernButton}"
                            Background="#EF4444"
                            Width="64"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区域 -->
        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05"/>
            </Border.Effect>
            <TextBox x:Name="ContentTextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="13"
                     Padding="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     SelectionBrush="#BFDBFE"/>
        </Border>
    </Grid>
</Window>
