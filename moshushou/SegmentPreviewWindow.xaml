<Window x:Class="moshushou.SegmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内容预览"
        Height="560"
        Width="860"
        MinHeight="360"
        MinWidth="560"
        Background="#F8FAFC">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="CopyAllButton"
                        Content="全部复制"
                        Width="88"
                        Margin="0,0,6,0"
                        Click="CopyAllButton_Click"/>
                <Button x:Name="CopyNumbersButton"
                        Content="复制单号"
                        Width="88"
                        Margin="0,0,6,0"
                        Click="CopyNumbersButton_Click"/>
                <Button x:Name="ShowAllButton"
                        Content="所有内容"
                        Width="88"
                        Margin="0,0,6,0"
                        Click="ShowAllButton_Click"/>
                <Button x:Name="CloseButton"
                        Content="关闭"
                        Width="64"
                        Click="CloseButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="SummaryTextBlock"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="#475569"
                       Text="0 行"/>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <TextBox x:Name="ContentTextBox"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="10"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
