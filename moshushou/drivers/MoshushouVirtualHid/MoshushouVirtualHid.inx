[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderName%
DriverVer=08/03/2026,1.0.0.1
CatalogFile=MoshushouVirtualHid.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskDescription%,,,

[SourceDisksFiles]
MoshushouVirtualHid.dll=1

[Manufacturer]
%ManufacturerName%=Moshushou,NTamd64.10.0...18362

[Moshushou.NTamd64.10.0...18362]
%DeviceDescription%=MoshushouVirtualHid,Root\MoshushouVirtualHid

[MoshushouVirtualHid.NT]
CopyFiles=UMDriverCopy

[MoshushouVirtualHid.NT.hw]
AddReg=MoshushouDeviceSecurity

[MoshushouDeviceSecurity]
HKR,,LowerFilters,0x00010008,"WUDFRd"
HKR,,DeviceCharacteristics,0x00010001,0x00000100
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[MoshushouVirtualHid.NT.Services]
AddService=WUDFRd,0x000001f8,WUDFRD_ServiceInstall
AddService=mshidumdf,0x000001fa,mshidumdf_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys
LoadOrderGroup=Base

[mshidumdf_ServiceInstall]
DisplayName=%MsHidUmdfDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mshidumdf.sys
LoadOrderGroup=Base

[MoshushouVirtualHid.NT.Wdf]
UmdfService=MoshushouVirtualHid,MoshushouVirtualHid_Install
UmdfServiceOrder=MoshushouVirtualHid
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[MoshushouVirtualHid_Install]
UmdfLibraryVersion=2.15.0
ServiceBinary=%13%\MoshushouVirtualHid.dll

[UMDriverCopy]
MoshushouVirtualHid.dll

[Strings]
ProviderName="Moshushou"
ManufacturerName="Moshushou"
DiskDescription="Moshushou Virtual HID Installation Disk"
DeviceDescription="Moshushou Virtual Keyboard and Mouse"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
MsHidUmdfDisplayName="Pass-through HID to UMDF Driver"
