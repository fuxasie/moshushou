<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="search_config.json" />
  </ItemGroup>

  <PropertyGroup>
    <DriverInstallerRoot>$(MSBuildProjectDirectory)\drivers\MoshushouVirtualHid\Installer</DriverInstallerRoot>
    <DriverPackageRoot>$(MSBuildProjectDirectory)\drivers\MoshushouVirtualHid\artifacts\Release\x64\package</DriverPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="drivers\**\*.cs" />
    <Compile Remove="publish\**\*.cs" />
  </ItemGroup>

  <Target Name="BuildVirtualHidInstaller" BeforeTargets="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(DriverInstallerRoot)\build.ps1&quot; -Configuration Release" />
  </Target>

  <ItemGroup>
    <Content Include="$(DriverInstallerRoot)\artifacts\Release\x64\Moshushou.DriverInstaller.exe">
      <Link>Driver\Moshushou.DriverInstaller.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(DriverPackageRoot)\MoshushouVirtualHid.dll;$(DriverPackageRoot)\MoshushouVirtualHid.inf;$(DriverPackageRoot)\MoshushouVirtualHid.cat">
      <Link>Driver\package\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(DriverPackageRoot)\MoshushouVirtualHidTest.cer" Condition="Exists('$(DriverPackageRoot)\MoshushouVirtualHidTest.cer')">
      <Link>Driver\package\MoshushouVirtualHidTest.cer</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.2.1" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="InputSimulator" Version="1.0.4" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.16.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <PackageReference Include="System.Reactive.Windows.Forms" Version="6.1.0" NoWarn="NU1701" />
    <PackageReference Include="WeChatOcr" Version="1.0.4">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="businfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="search_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\mmmojo.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\mmmojo_64.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\FPOCRRecog.xnet">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\OCRDetFP32.xnet.nas">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\OCRParaDetV1.1.0.26.xnet">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\OCRRecogFP32V1.1.0.26.xnet">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\RecDict">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\Model\sohu_simp.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\WeChatOCR.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wco_data\x64.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="wxonnx\yolo11n_wxscreen_fixed.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\wxonnx\**\*">
        <Link>wxonnx\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
