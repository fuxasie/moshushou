<Window x:Class="moshushou.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="杂项设置" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 悬浮窗控制 -->
        <GroupBox Grid.Row="0" Header="悬浮提示窗 (OSD) 设置" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <CheckBox x:Name="EnableOsdCheckBox"
                          Content="启用商家切换悬浮窗提示"
                          Margin="0,5"
                          Checked="EnableOsdCheckBox_Checked"
                          Unchecked="EnableOsdCheckBox_Unchecked"/>
                
                <Button x:Name="OsdSettingsButton"
                        Content="🎨 调整悬浮窗位置与大小"
                        Width="180" HorizontalAlignment="Left"
                        Margin="0,10,0,5" Padding="8,4"
                        Background="#8B5CF6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="OsdSettingsButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 快捷键相关设置 -->
        <GroupBox Grid.Row="1" Header="快捷键与发送设置" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <CheckBox x:Name="SkipNextOnCtrlSpaceCheckBox"
                          Content="禁止 Ctrl+空格 后自动跳下一项"
                          Margin="0,5"
                          ToolTip="勾选后，使用Ctrl+空格发送或粘贴后，不会自动跳转到下一项"
                          Checked="SkipNextOnCtrlSpaceCheckBox_Checked"
                          Unchecked="SkipNextOnCtrlSpaceCheckBox_Unchecked"/>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="4" 
                Content="关闭" 
                Width="80" Height="30"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
