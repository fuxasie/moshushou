<Window x:Class="moshushou.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ 设置" Height="620" Width="520"
        MinHeight="460" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- 区域标题样式 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <!-- 说明文字样式 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 输入框样式 -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="0" Background="Transparent" BorderBrush="#CBD5E1">
            <TabItem Header="业务设置" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🪟  悬浮提示窗 (OSD)" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="EnableOsdCheckBox"
                                          Content="启用商家切换时的悬浮提示"
                                          Checked="EnableOsdCheckBox_Checked"
                                          Unchecked="EnableOsdCheckBox_Unchecked"
                                          Margin="0,0,0,10"/>
                                <Button x:Name="OsdSettingsButton"
                                        Content="🎨 调整悬浮窗位置与大小"
                                        Style="{StaticResource PrimaryBtn}"
                                        Background="#8B5CF6"
                                        HorizontalAlignment="Left"
                                        Click="OsdSettingsButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📎  同群少量商家汇总文件" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="EnableGroupMergeCheckBox"
                                          Content="加载 Excel 后自动在符合条件的群下方追加汇总文件"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="同群少于 100 条的商家多于几个时生成汇总"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="多于" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="GroupSummaryMinCountTextBox"
                                             Width="56"
                                             Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="个商家（默认 5，可保存）"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="商家仍各自独立显示。当同一群名下少于 100 条的商家超过上述数量时，只在该群列表下方追加一个汇总文件项（可按文件发送，含企业微信）。达到 100 条的商家不进入汇总。"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,10"/>
                                <Button x:Name="SaveGroupMergeSettingsButton"
                                        Content="保存并立即生成汇总"
                                        Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Left"
                                        Click="SaveGroupMergeSettingsButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⌨  快捷键与发送" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="SkipNextOnCtrlSpaceCheckBox"
                                          Content="Ctrl+空格 粘贴后不自动跳下一项"
                                          ToolTip="勾选后，Ctrl+空格 发送/粘贴后不会自动切换到下一个商家"
                                          Checked="SkipNextOnCtrlSpaceCheckBox_Checked"
                                          Unchecked="SkipNextOnCtrlSpaceCheckBox_Unchecked"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📂  文件解析设置" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="CurrentFileTextBlock"
                                           Text="（未加载文件）"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="解析模式" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="ModeComboBox" Grid.Column="1"
                                              Height="28"
                                              SelectionChanged="ModeComboBox_SelectionChanged"/>
                                </Grid>

                                <Border x:Name="IssueConfigPanel"
                                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="运单号列" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TrackingColumnTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="商家名列" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                        <TextBox x:Name="StoreColumnTextBox" Grid.Row="0" Grid.Column="4" Style="{StaticResource FieldBox}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="分段起始" Style="{StaticResource FieldLabel}" Margin="0,8,6,0"/>
                                        <TextBox x:Name="IssueSegmentStartCountTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource FieldBox}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                                                   Text="条（最小 2，超过此数量时分段发送）"
                                                   Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="MagicianConfigPanel"
                                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="尾部自定义话术" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TailMessageTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="72"
                                                 VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#CBD5E1"
                                                 Padding="6,4"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="ParseHintTextBlock"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,10"/>

                                <Button x:Name="ApplyParseButton"
                                        Content="✔ 应用并重载数据"
                                        Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"
                                        Click="ApplyParseButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="键鼠模拟与驱动" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🖱  键鼠模拟方式" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="模拟后端" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="InputBackendComboBox" Grid.Column="1" Height="28">
                                        <ComboBoxItem Tag="VirtualHid" Content="Virtual HID（推荐）"/>
                                        <ComboBoxItem Tag="SendInput" Content="SendInput（兼容模式）"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AllowInputFallbackCheckBox"
                                          Content="驱动不可用时允许回退到 SendInput"
                                          Margin="0,0,0,10"/>
                                <Button Content="保存键鼠模拟设置"
                                        Style="{StaticResource PrimaryBtn}"
                                        HorizontalAlignment="Left"
                                        Click="SaveInputBackendButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔧  Virtual HID 驱动管理" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <TextBlock Text="管理 Virtual HID 驱动的检测和卸载。卸载后需重新启动软件。"
                                           Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="InputBackendStatusTextBlock"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="检测驱动状态"
                                            Style="{StaticResource SecondaryBtn}"
                                            Margin="0,0,8,0"
                                            Click="CheckVirtualHidButton_Click"/>
                                    <Button x:Name="UninstallVirtualHidButton"
                                            Content="卸载 Virtual HID 驱动"
                                            Style="{StaticResource DangerBtn}"
                                            Click="UninstallVirtualHidButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="调试与日志" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔍  失败 OCR 调试采集"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,8"/>
                                <CheckBox x:Name="EnableFailedOcrDebugCaptureCheckBox"
                                          Content="自动发送失败时保存群名 OCR 调试数据"
                                          Checked="EnableFailedOcrDebugCaptureCheckBox_Checked"
                                          Unchecked="EnableFailedOcrDebugCaptureCheckBox_Unchecked"
                                          Margin="0,0,0,8"/>
                                <TextBlock Text="开启后，每次自动发送失败会保存：群名区域原始截图、预期群名、OCR 原文、清洗结果、应用来源、失败阶段以及是否位于自动重试区。不会保存聊天正文区域。"
                                           Style="{StaticResource HintText}"
                                           Margin="0,0,0,10"/>
                                <Button Content="打开失败 OCR 调试目录"
                                        Style="{StaticResource SecondaryBtn}"
                                        HorizontalAlignment="Left"
                                        Click="OpenFailedOcrDebugDirectoryButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1"
                Content="关闭"
                Style="{StaticResource SecondaryBtn}"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Width="80"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
