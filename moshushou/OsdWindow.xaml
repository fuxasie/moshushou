<Window x:Class="moshushou.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSDWindow" 
        Height="150" Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowActivated="False" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    
    <Grid Background="Transparent">
        <Border x:Name="BgBorder" Background="#CC000000" CornerRadius="14" Margin="16">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.7" Color="Black"/>
            </Border.Effect>
            <StackPanel Margin="22,14" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 第一行：列表序号（金色，较小）+ 商家名（白色，大号主标题） -->
                <TextBlock x:Name="StoreBlock"
                           TextAlignment="Center"
                           Margin="0,0,0,4">
                    <Run x:Name="SequenceRun"
                         Foreground="#FFD700"
                         FontSize="22"
                         FontWeight="Bold"
                         Text=""/>
                    <Run x:Name="StoreRun"
                         Foreground="White"
                         FontSize="36"
                         FontWeight="Bold"
                         Text=""/>
                </TextBlock>

                <!-- 第三行：群名（蓝色，可隐藏） -->
                <TextBlock x:Name="GroupBlock"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,0,0,4">
                    <Run x:Name="GroupRun"
                         Foreground="#00BFFF"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Text=""/>
                </TextBlock>

                <!-- 第四行：末条单号（橙色，可隐藏） -->
                <TextBlock x:Name="LastTrackingBlock"
                           TextAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,0,0,0">
                    <Run Foreground="#94A3B8" FontSize="17" FontWeight="Normal" Text="末条  "/>
                    <Run x:Name="LastTrackingRun"
                         Foreground="#FB923C"
                         FontSize="20"
                         FontWeight="Bold"
                         Text=""/>
                </TextBlock>

            </StackPanel>
        </Border>

        <!-- 编辑模式下的调整手柄和蒙层 -->
        <Border x:Name="EditOverlay" Visibility="Collapsed" BorderBrush="#00FF00" BorderThickness="2" CornerRadius="12" Margin="20" Background="#3300FF00" 
                MouseLeftButtonDown="EditOverlay_MouseLeftButtonDown" MouseRightButtonDown="OsdWindow_MouseRightButtonDown">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock Text="[编辑模式] 右键退出编辑&#x0a;拖动矩形移动位置，拖右下角改大小" 
                           Foreground="White" FontSize="14" FontWeight="Bold" 
                           TextAlignment="Center"/>
                <!-- 背景透明度调节 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="背景透明度:" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="OpacitySlider" Width="140" Minimum="0" Maximum="100" Value="60" 
                            VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"
                            ToolTip="调节背景透明度（0=全透明，100=不透明）"/>
                    <TextBlock x:Name="OpacityValueText" Text="60%" Foreground="#FFD700" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <!-- 是否显示群名（全局生效） -->
                <CheckBox x:Name="ShowPasteInfoCheckBox" Content="显示群名（统一生效）" Foreground="White" FontSize="13" 
                          IsChecked="True" Margin="0,8,0,0" VerticalContentAlignment="Center"
                          Checked="ShowPasteInfoCheckBox_Changed" Unchecked="ShowPasteInfoCheckBox_Changed"/>
                <Button x:Name="ExitEditModeButton" Content="✅ 退出调整并保存" Margin="0,10,0,0" Padding="12,6" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ExitEditModeButton_Click"/>
            </StackPanel>
        </Border>
        
        <Thumb x:Name="ResizeThumb" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Visibility="Collapsed" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 10,20 L 20,20 L 20,10 Z" Fill="White" Opacity="0.8"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
