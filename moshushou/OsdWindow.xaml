<Window x:Class="moshushou.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSDWindow" 
        Height="150" Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ShowActivated="False" 
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    
    <Grid Background="Transparent">
        <Border x:Name="BgBorder" Background="#99000000" CornerRadius="12" Margin="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <!-- 给包裹文字设置自适应居左或居中，可结合实际效果修改，默认居中拉伸 -->
            <Viewbox Stretch="Uniform" Margin="20,10">
                <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                    <Run x:Name="SequenceRun" Foreground="#FFD700" FontSize="36" FontWeight="Bold" Text=""/>
                    <Run x:Name="MessageRun" Foreground="White" FontSize="48" FontWeight="Bold" Text="商家名"/>
                </TextBlock>
            </Viewbox>
        </Border>

        <!-- 编辑模式下的调整手柄和蒙层 -->
        <Border x:Name="EditOverlay" Visibility="Collapsed" BorderBrush="#00FF00" BorderThickness="2" CornerRadius="12" Margin="20" Background="#3300FF00" 
                MouseLeftButtonDown="EditOverlay_MouseLeftButtonDown" MouseRightButtonDown="OsdWindow_MouseRightButtonDown">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock Text="[编辑模式] 右键退出编辑&#x0a;拖动矩形移动位置，拖右下角改大小" 
                           Foreground="White" FontSize="14" FontWeight="Bold" 
                           TextAlignment="Center"/>
                <Button x:Name="ExitEditModeButton" Content="✅ 退出调整并保存" Margin="0,15,0,0" Padding="12,6" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ExitEditModeButton_Click"/>
            </StackPanel>
        </Border>
        
        <Thumb x:Name="ResizeThumb" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Visibility="Collapsed" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 10,20 L 20,20 L 20,10 Z" Fill="White" Opacity="0.8"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
