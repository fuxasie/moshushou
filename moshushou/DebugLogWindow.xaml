<Window x:Class="moshushou.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="调试日志"
        Height="520"
        Width="980"
        MinHeight="300"
        MinWidth="520"
        Background="#F5F7FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderGradient}"
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05"/>
            </Border.Effect>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="ClearLogButton"
                            Content="清空日志"
                            Style="{StaticResource ModernButton}"
                            Background="#6B7280"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="ClearLogButton_Click"/>
                    <Button x:Name="CopyAllButton"
                            Content="复制所有"
                            Style="{StaticResource ModernButton}"
                            Background="#3B82F6"
                            Width="80"
                            Margin="0,0,8,0"
                            Click="CopyAllButton_Click"/>
                    <Button x:Name="ChangeParseButton"
                            Content="解析设置"
                            Style="{StaticResource ModernButton}"
                            Background="#8B5CF6"
                            Width="80"
                            Margin="0,0,8,0"
                            Click="ChangeParseButton_Click"/>
                    <Button x:Name="ClearHistoryButton"
                            Content="清空历史"
                            Style="{StaticResource ModernButton}"
                            Background="#EF4444"
                            Width="80"
                            Margin="0,0,16,0"
                            Click="ClearHistoryButton_Click"/>
                    
                    <!-- 筛选区域 -->
                    <Border CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" Margin="0,0,8,0">
                        <TextBox x:Name="FilterTextBox"
                                 Width="220"
                                 Height="26"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,0"
                                 TextChanged="FilterTextBox_TextChanged"
                                 ToolTip="按关键词筛选日志，例如店铺名、成功、失败"/>
                    </Border>
                    
                    <CheckBox x:Name="HistoryOnlyCheckBox"
                              Content="仅历史"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,8,0"
                              Checked="HistoryOnlyCheckBox_Changed"
                              Unchecked="HistoryOnlyCheckBox_Changed"/>
                    <CheckBox x:Name="AutoScrollCheckBox"
                              Content="自动滚动"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="True"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="CounterTextBlock"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#475569"
                           FontSize="12"
                           Text="0 行"/>
            </DockPanel>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="1" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                CornerRadius="6" 
                Background="White">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.05"/>
            </Border.Effect>
            <ListBox x:Name="LogListBox"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="12"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4"
                     HorizontalContentAlignment="Stretch"
                     SelectionMode="Extended">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="2" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#1E3A8A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</Window>
