<Window x:Class="moshushou.BusInfoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="businfo 映射管理"
        Height="650"
        Width="980"
        MinHeight="540"
        MinWidth="840"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Background="White"
                Padding="12"
                Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Style="{StaticResource InputTextBox}"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="搜索商家名/群名/来源"/>

                <Button Grid.Column="1"
                        Content="清空搜索"
                        Style="{StaticResource ModernButton}"
                        Background="#64748B"
                        Margin="12,0,0,0"
                        Width="80"
                        Height="32"
                        Click="ClearSearchButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Background="White"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="6" ShadowDepth="2"/>
            </Border.Effect>

            <DataGrid x:Name="MappingDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="MappingDataGrid_SelectionChanged"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      VerticalGridLinesBrush="Transparent"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="36">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="商家名" Binding="{Binding StoreName}" Width="2*"/>
                    <DataGridTextColumn Header="群名" Binding="{Binding GroupName}" Width="3*"/>
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Background="White"
                Padding="16"
                Margin="0,12,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="商家名" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="EditorStoreNameTextBox"
                         Grid.Row="1"
                         Grid.Column="0"
                         Style="{StaticResource InputTextBox}"
                         Margin="0,0,12,0"
                         ToolTip="商家名"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="群名" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="EditorGroupNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource InputTextBox}"
                         Margin="0,0,12,0"
                         ToolTip="群名"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="来源（可选）" Foreground="#64748B" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="EditorSourceComboBox"
                          Grid.Row="1"
                          Grid.Column="2"
                          Height="32"
                          Margin="0,0,12,0"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          Padding="6,0">
                    <ComboBoxItem Content=""/>
                    <ComboBoxItem Content="企业微信"/>
                    <ComboBoxItem Content="微信"/>
                </ComboBox>

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Width="80"
                        Height="32"
                        Content="清空"
                        Style="{StaticResource ModernButton}"
                        Click="ClearEditorButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="AddOrMergeButton"
                        Width="110"
                        Height="36"
                        Content="新增/覆盖"
                        Style="{StaticResource StandardPrimaryButton}"
                        Click="AddOrMergeButton_Click"/>

                <Button x:Name="UpdateButton"
                        Width="90"
                        Height="36"
                        Margin="12,0,0,0"
                        Content="修改选中"
                        Style="{StaticResource ModernButton}"
                        Background="#3B82F6"
                        Click="UpdateButton_Click"/>

                <Button x:Name="DeleteButton"
                        Width="90"
                        Height="36"
                        Margin="12,0,0,0"
                        Content="删除选中"
                        Style="{StaticResource ModernButton}"
                        Background="#EF4444"
                        Click="DeleteButton_Click"/>

                <TextBlock x:Name="SummaryTextBlock"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontWeight="Medium"
                           Text="显示 0 / 共 0 条"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="HintTextBlock"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"
                           FontSize="12"
                           Text="提示：新增/覆盖会按商家名去重。"/>

                <Button Width="100"
                        Height="36"
                        Content="保存并关闭"
                        Style="{StaticResource StandardPrimaryButton}"
                        Click="SaveAndCloseButton_Click"/>

                <Button Width="80"
                        Height="36"
                        Margin="12,0,0,0"
                        Content="取消"
                        Style="{StaticResource ModernButton}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
